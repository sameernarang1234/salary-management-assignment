# Copy to .env.production on the server, fill in, and keep it private (chmod 600).
# Never commit the real file.

# The address the app is served at. Caddy gets an HTTPS certificate for it.
# Free option: your Elastic IP with dashes + .sslip.io, e.g. 13-233-10-20.sslip.io
DOMAIN=13-233-10-20.sslip.io

NODE_ENV=production
PORT=3000

# Amazon RDS PostgreSQL. sslmode=verify-full checks the server's certificate against the
# Amazon CA bundle built into the image. URL-encode special characters in the password
# (e.g. @ as %40, / as %2F).
DATABASE_URL=postgresql://salary_admin:CHANGE_ME@salary-db.xxxxxxxxxxxx.ap-southeast-2.rds.amazonaws.com:5432/salary?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem

# The single HR Manager account, created by the seed. Use a new, long, random password.
HR_MANAGER_EMAIL=hr.manager@your-company.example
HR_MANAGER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
