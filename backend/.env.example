# Development database (docker-compose.yml). Local-demo credentials only.
DATABASE_URL="postgresql://salary:salary@localhost:5432/salary_dev"
PORT=3000

# The single HR Manager account, created by `npm run seed`.
# Local-demo defaults only: set your own values in any shared or production environment.
HR_MANAGER_EMAIL="hr.manager@acme.example"
HR_MANAGER_PASSWORD="ChangeMe-Demo-2026"

# Optional: seed number and size (defaults 42 and 10000).
# SEED=42
# SEED_EMPLOYEES=10000
